# Copia este archivo a .env (NO lo subas al repositorio) y completa los valores.
SERVER_PORT=8080
SPRING_DATA_MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/authprofiles

JWT_SECRET=genera-uno-con-openssl-rand-base64-64
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Local: localhost. En AWS: IP privada de la EC2 donde corre Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# En AWS: la contraseña con la que se inició Redis (--requirepass). Local: vacío
REDIS_PASSWORD=
# false para Redis propio (docker compose local o EC2 con Docker). true solo con un Redis administrado con TLS
REDIS_SSL=false

RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=no-reply@tu-dominio.com

GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# OAuth de GitHub (crea la OAuth App en github.com/settings/developers)
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Solo obligatorio si la OAuth App tiene más de una Authorization callback URL configurada.
# En producción debe ser igual a la callback registrada: https://<tu-dominio-vercel>/auth/github/callback
GITHUB_REDIRECT_URI=

# Amazon S3 (fotos de perfil: bucket de lectura pública; documentos: bucket PRIVADO)
AWS_REGION=us-east-2
S3_PHOTOS_BUCKET=taskit-profile-photos
S3_DOCUMENTS_BUCKET=taskit-identity-documents
# Minutos de vigencia del enlace prefirmado para revisar documentos
SAS_TTL_MINUTES=10
# SOLO local con S3Mock (docker compose, puerto 9090). En AWS déjalos sin definir: se usa el rol IAM de la tarea
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Administrador inicial (si ADMIN_PASSWORD queda vacío no se crea)
ADMIN_EMAIL=admin@omnitask.com
ADMIN_PASSWORD=

# Orígenes del frontend, separados por coma, sin espacios ni barra final
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://taskit-frontend-ten.vercel.app

# --- Kafka ---
# Local (docker compose up -d): no hace falta cambiar nada, se usa localhost:9092 sin seguridad.
# AWS (Kafka en una EC2 con Docker, SASL/PLAIN dentro de la VPC): ver docs/eventos-y-documentos.md, sección 7
# KAFKA_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=<IP privada de la EC2>:9092
# KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="taskit" password="<contraseña de Kafka>";
# KAFKA_CONSUMER_GROUP=auth-profile-service
# KAFKA_ENABLED=false apaga el envío y el consumo; los eventos se acumulan en outbox_events
